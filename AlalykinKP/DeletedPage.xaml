<Page x:Class="AlalykinKP.DeletedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Удаленные записи" FontFamily="Courier New" Background="#89e892">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Корзина (Удаленные записи)" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <ListView Name="DeletedList" Grid.Row="1" Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0,5"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Image Width="120" Height="120" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center" Source="{Binding ImageFull}"/>

                        <Border Grid.Column="1" Background="#C9F2CE" BorderThickness="1" BorderBrush="Gray" CornerRadius="5" Padding="10" Margin="5,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding familya}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text=" " FontSize="20"/>
                                    <TextBlock Text="{Binding imya}" FontSize="20"/>
                                    <TextBlock Text=" " FontSize="20"/>
                                    <TextBlock Text="{Binding otchestvo}" FontSize="20"/>
                                    <TextBlock Text=" — " FontSize="20"/>
                                    <TextBlock Text="{Binding Звание.zvanie}" FontSize="20" Foreground="DarkBlue" FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Рота: " FontSize="15" Foreground="DimGray"/>
                                    <TextBlock Text="{Binding Роты.nazvanie_roty}" FontSize="15"/>
                                    <TextBlock Text=" | Должность: " FontSize="15" Foreground="DimGray"/>
                                    <TextBlock Text="{Binding dolzhnost}" FontSize="15"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Дата рождения: " FontSize="15" Foreground="DimGray"/>
                                    <TextBlock Text="{Binding data_rozhdeniya,StringFormat=dd.MM.yyyy}" FontSize="15"/>
                                    <TextBlock Text="   |   Дата поступления: " FontSize="15" Foreground="DimGray"/>
                                    <TextBlock Text="{Binding data_postupleniya,StringFormat=dd.MM.yyyy}" FontSize="15"/>
                                </StackPanel>

                                <Grid Grid.Row="3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Награды: " FontSize="15" Foreground="DimGray"/>
                                        <TextBlock Text="{Binding nagrady}" FontSize="15"/>
                                        <TextBlock Text=" | Участие: " FontSize="15" Foreground="DimGray"/>
                                        <TextBlock Text="{Binding uchastie}" FontSize="15"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Name="RestoreButton" Content="Восстановить" Margin="5,0" FontSize="14" Padding="10,2" Click="RestoreButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>