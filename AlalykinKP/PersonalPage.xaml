<Page x:Class="AlalykinKP.PersonalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AlalykinKP"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1200"
      Title="PersonalPage" FontFamily="Courier New">

    <Grid Background="#89e892">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Поиск" Margin="5" FontSize="16" VerticalAlignment="Center"/>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" FontSize="16" Width="150" Padding="2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Рота:" Margin="5" FontSize="16" VerticalAlignment="Center"/>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="16" Width="140" Padding="2">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>мотострелковая рота</TextBlock>
                    <TextBlock>танковая рота</TextBlock>
                    <TextBlock>воздушно-десантная рота</TextBlock>
                    <TextBlock>рота морской пехоты</TextBlock>
                    <TextBlock>рота БПЛА</TextBlock>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Звание:" Margin="5" FontSize="16" VerticalAlignment="Center"/>
                <ComboBox Name="ComboZvanie" SelectionChanged="ComboZvanie_SelectionChanged" FontSize="16" Width="130" Padding="2">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>Рядовой</TextBlock>
                    <TextBlock>Сержант</TextBlock>
                    <TextBlock>Лейтенант</TextBlock>
                    <TextBlock>Капитан</TextBlock>
                    <TextBlock>Майор</TextBlock>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Статус:" Margin="5" FontSize="16" VerticalAlignment="Center"/>
                <ComboBox Name="ComboStatus" SelectionChanged="ComboStatus_SelectionChanged" FontSize="16" Width="220" Padding="2">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>Только с наградами (и без участия)</TextBlock>
                    <TextBlock>Только участники (и без наград)</TextBlock>
                    <TextBlock>И награды, И участие</TextBlock>
                    <TextBlock>Без наград и участия</TextBlock>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Сортировка:" Margin="5" FontSize="16" VerticalAlignment="Center"/>
                <ComboBox Name="SortType" SelectionChanged="SortType_SelectionChanged" FontSize="16" Width="210" Padding="2">
                    <TextBlock>без сортировки</TextBlock>
                    <TextBlock>Фамилия (А-Я)</TextBlock>
                    <TextBlock>Фамилия (Я-А)</TextBlock>
                    <TextBlock>Дата рождения (новые)</TextBlock>
                    <TextBlock>Дата рождения (старые)</TextBlock>
                    <TextBlock>Дата поступления (новые)</TextBlock>
                    <TextBlock>Дата поступления (старые)</TextBlock>
                    <TextBlock>Звание (по возрастанию)</TextBlock>
                    <TextBlock>Звание (по убыванию)</TextBlock>
                </ComboBox>
            </StackPanel>

            <Button Name="AddButton" Content="Добавить" Click="AddButton_Click" FontSize="16" Padding="10,2" Margin="10,5,5,5"/>
            <Button Name="DeletedItemsButton" Content="Корзина" Click="DeletedItemsButton_Click" FontSize="16" Padding="10,2" Margin="5"/>
            <TextBlock Name="personalCount" FontSize="16" VerticalAlignment="Center" Margin="10,5,0,5"/>
        </WrapPanel>

        <ListView Name="ListView" Grid.Row="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0,5"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Image Width="120" Height="120" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center" Source="{Binding ImageFull}"/>

                        <Border Grid.Column="1" Background="#C9F2CE" BorderThickness="1" BorderBrush="Gray" CornerRadius="5" Padding="10" Margin="5,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding familya}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text=" " FontSize="20"/>
                                    <TextBlock Text="{Binding imya}" FontSize="20"/>
                                    <TextBlock Text=" " FontSize="20"/>
                                    <TextBlock Text="{Binding otchestvo}" FontSize="20"/>
                                    <TextBlock Text=" — " FontSize="20"/>
                                    <TextBlock Text="{Binding Звание.zvanie}" FontSize="20" Foreground="DarkBlue" FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Рота: " FontSize="15" Foreground="DimGray"/>
                                    <TextBlock Text="{Binding Роты.nazvanie_roty}" FontSize="15"/>
                                    <TextBlock Text=" | Должность: " FontSize="15" Foreground="DimGray"/>
                                    <TextBlock Text="{Binding dolzhnost}" FontSize="15"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Дата рождения: " FontSize="15" Foreground="DimGray"/>
                                    <TextBlock Text="{Binding data_rozhdeniya,StringFormat=dd.MM.yyyy}" FontSize="15"/>
                                    <TextBlock Text="   |   Дата поступления: " FontSize="15" Foreground="DimGray"/>
                                    <TextBlock Text="{Binding data_postupleniya,StringFormat=dd.MM.yyyy}" FontSize="15"/>
                                </StackPanel>

                                <Grid Grid.Row="3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Награды: " FontSize="15" Foreground="DimGray"/>
                                        <TextBlock Text="{Binding nagrady}" FontSize="15"/>
                                        <TextBlock Text=" | Участие: " FontSize="15" Foreground="DimGray"/>
                                        <TextBlock Text="{Binding uchastie}" FontSize="15"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="История званий" Margin="5,0" FontSize="14" Padding="10,2" Click="HistoryButton_Click"/>
                                        <Button Name="EditButton" Content="Редактировать" Margin="5,0" FontSize="14" Padding="10,2" Click="EditButton_Click"/>
                                        <Button Name="DeleteButton" Content="Удалить" Margin="5,0" FontSize="14" Padding="10,2" Click="DeleteButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>